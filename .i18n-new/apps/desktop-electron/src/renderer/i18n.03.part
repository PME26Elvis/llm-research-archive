export type TranslationKey = keyof typeof zhTW;
export type Translator = (key: TranslationKey, params?: TranslationParams) => string;

export function translate(locale: UiLocale, key: TranslationKey, params: TranslationParams = {}): string {
  const template = (locale === 'en' ? en : zhTW)[key];
  return template.replace(/\{([a-zA-Z0-9]+)\}/g, (_match, name: string) =>
    Object.prototype.hasOwnProperty.call(params, name) ? String(params[name]) : `{${name}}`,
  );
}

export function resolveLocale(
  preference: LanguagePreference,
  systemLanguages: readonly string[],
): UiLocale {
  if (preference !== 'system') return preference;
  return systemLanguages.some((language) => language.toLowerCase().startsWith('zh')) ? 'zh-TW' : 'en';
}
