{
  "name": "llm-research-archive-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 apps/desktop-electron/src/renderer",
    "build": "npm run content:manifest && tsc -b",
    "lint": "node scripts/validate-architecture.mjs",
    "lint:fix": "npm run lint",
    "format": "prettier --check \"{package.json,tsconfig*.json,vitest.config.ts,scripts/**/*.{mjs,js},packages/**/*.{ts,json},apps/**/*.{ts,tsx,mjs,json,html},.github/workflows/desktop-*.yml}\"",
    "format:check": "npm run format",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:contract": "vitest run packages/platform-contracts packages/application",
    "test:renderer": "vitest run packages/renderer-ui",
    "test:e2e": "node apps/desktop-electron/e2e/smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:security": "node scripts/security-check.mjs",
    "test:compatibility": "vitest run packages/content-engine",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:traceability": "node scripts/validate-traceability.mjs",
    "content:scan": "node --import tsx scripts/content-scan.mjs",
    "content:manifest": "node --import tsx scripts/content-manifest.mjs",
    "content:diagnose": "node --import tsx scripts/content-diagnose.mjs",
    "package": "npm run build",
    "make": "npm run make:linux",
    "make:windows": "npm run build && node scripts/release-assets.mjs windows",
    "make:linux": "npm run build && node scripts/release-assets.mjs linux",
    "release:assets": "node scripts/release-assets.mjs all",
    "benchmark": "node --import tsx scripts/node-smoke.mjs --benchmark",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run validate:traceability && npm run test && npm run test:e2e && npm run test:security && npm run test:compatibility && npm run build",
    "format:write": "prettier --write \"{package.json,tsconfig*.json,vitest.config.ts,scripts/**/*.{mjs,js},packages/**/*.{ts,json},apps/**/*.{ts,tsx,mjs,json,html},.github/workflows/desktop-*.yml}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.3",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "prettier": "^3.3.2",
    "js-yaml": "^4.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^31.2.1",
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "tsx": "^4.16.2"
  }
}
