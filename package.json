{
  "name": "llm-research-archive-desktop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "electron-forge start -- --no-sandbox",
    "build": "npm run content:manifest && electron-forge package",
    "lint": "node scripts/validate-architecture.mjs",
    "lint:fix": "npm run lint",
    "format": "prettier --check \"{package.json,tsconfig*.json,vitest.config.ts,playwright.config.ts,scripts/**/*.{mjs,js},packages/**/*.{ts,json},apps/**/*.{ts,tsx,mjs,json,html},project-docs/quality/*.json,.github/workflows/desktop-*.yml}\"",
    "format:check": "npm run format",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:contract": "vitest run packages/platform-contracts packages/application",
    "test:renderer": "vitest run packages/renderer-ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage && node scripts/verify-coverage-policy.mjs",
    "test:security": "vitest run apps/desktop-electron/tests/security.spec.ts",
    "test:compatibility": "vitest run packages/content-engine",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:traceability": "node scripts/validate-traceability.mjs",
    "content:scan": "node --import tsx scripts/content-scan.mjs",
    "content:manifest": "node --import tsx scripts/content-manifest.mjs",
    "content:diagnose": "node --import tsx scripts/content-diagnose.mjs",
    "package": "npm run content:manifest && electron-forge package",
    "make": "npm run make:linux",
    "make:windows": "npm run content:manifest && electron-forge make --platform win32 --arch x64 && node scripts/release-assets.mjs windows",
    "make:linux": "npm run content:manifest && electron-forge make --platform linux --arch x64 && node scripts/release-assets.mjs linux",
    "make:macos:arm64": "npm run content:manifest && electron-forge make --platform darwin --arch arm64 && node scripts/release-assets.mjs macos-arm64",
    "make:macos:x64": "npm run content:manifest && electron-forge make --platform darwin --arch x64 && node scripts/release-assets.mjs macos-x64",
    "release:assets": "node scripts/release-assets.mjs all",
    "benchmark": "node --import tsx scripts/node-smoke.mjs --benchmark",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run validate:traceability && npm run validate:generated && npm run validate:release-assets && npm run test:coverage && npm run test:security && npm run test:compatibility && npm run validate:accessibility && npm run validate:dependencies && npm run benchmark:search && npm run build && npm run validate:footprint:renderer",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "format:write": "prettier --write \"{package.json,tsconfig*.json,vitest.config.ts,playwright.config.ts,scripts/**/*.{mjs,js},packages/**/*.{ts,json},apps/**/*.{ts,tsx,mjs,json,html},project-docs/quality/*.json,.github/workflows/desktop-*.yml}\"",
    "validate:generated": "node scripts/validate-generated-clean.mjs",
    "validate:release-assets": "node scripts/validate-release-assets.mjs",
    "benchmark:search": "node --import tsx scripts/search-benchmark.mjs",
    "validate:accessibility": "node scripts/validate-accessibility.mjs",
    "validate:dependencies": "node scripts/validate-dependencies.mjs",
    "validate:footprint:renderer": "node scripts/verify-footprint.mjs renderer",
    "validate:footprint:package": "node scripts/verify-footprint.mjs package"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "1.6.0",
    "electron": "43.1.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.3.2",
    "semver": "^7.8.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.5",
    "zod": "^3.23.8"
  },
  "main": ".vite/build/main.js",
  "productName": "Research Observatory",
  "description": "Offline Research Observatory desktop archive reader",
  "license": "MIT",
  "author": {
    "name": "PME26Elvis"
  }
}
