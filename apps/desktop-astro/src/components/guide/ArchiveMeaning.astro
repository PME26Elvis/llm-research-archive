---
import type { DeepResearchGuide } from '@research-observatory/deep-research-guide';
interface Props {
  guide: DeepResearchGuide;
}
const { guide } = Astro.props;
const section = guide.sections.find((item) => item.id === 'guide.archive')!;
---

<section
  id={`${'guide.archive'}-${guide.locale}`}
  class="guide-section"
  data-guide-section="guide.archive"
  tabindex="-1"
>
  <p class="guide-section-kicker">{section.label}</p>
  <h2>{section.title}</h2>
  <p>{section.intro}</p>
  <div class="guide-archive-grid">
    <article>
      <h3>{guide.ui.whyPreserve}</h3><ul>
        {guide.archive.rationale.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <h3>{guide.ui.whatPreserved}</h3><ul>
        {guide.archive.preserves.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article>
      <h3>{guide.ui.notGuaranteed}</h3><ul>
        {guide.archive.doesNotGuarantee.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </div>
</section>
