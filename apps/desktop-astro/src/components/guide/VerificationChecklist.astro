---
import type { DeepResearchGuide } from '@research-observatory/deep-research-guide';
interface Props {
  guide: DeepResearchGuide;
}
const { guide } = Astro.props;
const section = guide.sections.find((item) => item.id === 'guide.verify')!;
---

<section
  id={`${'guide.verify'}-${guide.locale}`}
  class="guide-section"
  data-guide-section="guide.verify"
  tabindex="-1"
>
  <p class="guide-section-kicker">{section.label}</p>
  <h2>{section.title}</h2>
  <p>{section.intro}</p>
  <ol class="guide-checklist">{guide.verificationChecklist.map((item) => <li>{item}</li>)}</ol>
</section>
