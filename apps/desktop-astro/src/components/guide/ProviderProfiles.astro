---
import type { DeepResearchGuide } from '@research-observatory/deep-research-guide';
interface Props {
  guide: DeepResearchGuide;
}
const { guide } = Astro.props;
const section = guide.sections.find((item) => item.id === 'guide.providers')!;
---

<section
  id={`${'guide.providers'}-${guide.locale}`}
  class="guide-section"
  data-guide-section="guide.providers"
  tabindex="-1"
>
  <p class="guide-section-kicker">{section.label}</p>
  <h2>{section.title}</h2>
  <p>{section.intro}</p>
  <div class="guide-provider-list">
    {
      guide.providers.map((provider, index) => (
        <details open={index === 0} data-provider={provider.id}>
          <summary>
            <>
              <span>{provider.provider}</span>
              <strong>{provider.productName}</strong>
            </>
          </summary>
          <div class="guide-provider-body">
            <p class="guide-naming-note">{provider.namingNote}</p>
            <dl>
              <>
                <dt>{guide.ui.launch}</dt>
                <dd>{provider.launchDate ?? guide.ui.notStated}</dd>
              </>
              <>
                <dt>{guide.ui.modelContext}</dt>
                <dd>{provider.modelContext}</dd>
              </>
            </dl>
            <p>{provider.summary}</p>
            <h3>{guide.ui.characteristics}</h3>
            <ul>
              {provider.characteristics.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <h3>{guide.ui.limitations}</h3>
            <ul>
              {provider.limitations.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <div class="guide-source-links">
              {provider.sourceIds.map((sourceId) => (
                <button type="button" data-guide-source-select={sourceId}>
                  {guide.ui.source}: {sourceId}
                </button>
              ))}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>
