---
import type { DeepResearchGuide } from '@research-observatory/deep-research-guide';
interface Props {
  guide: DeepResearchGuide;
}
const { guide } = Astro.props;
const workflow = guide.sections.find((item) => item.id === 'guide.workflow')!;
const distinctions = guide.sections.find((item) => item.id === 'guide.distinctions')!;
---

<section
  id={`${'guide.workflow'}-${guide.locale}`}
  class="guide-section"
  data-guide-section="guide.workflow"
  tabindex="-1"
>
  <p class="guide-section-kicker">{workflow.label}</p>
  <h2>{workflow.title}</h2>
  <p>{workflow.intro}</p>
  <ol class="guide-workflow">
    {
      guide.workflow.map((step, index) => (
        <li>
          <>
            <span>{index + 1}</span>
            <div>
              <>
                <h3>{step.title}</h3>
                <p>{step.detail}</p>
              </>
            </div>
          </>
        </li>
      ))
    }
  </ol>
</section>
<section
  id={`${'guide.distinctions'}-${guide.locale}`}
  class="guide-section"
  data-guide-section="guide.distinctions"
  tabindex="-1"
>
  <p class="guide-section-kicker">{distinctions.label}</p>
  <h2>{distinctions.title}</h2>
  <p>{distinctions.intro}</p>
  <div class="guide-distinction-grid">
    {
      guide.distinctions.map((item) => (
        <article>
          <>
            <h3>{item.title}</h3>
            <p>{item.detail}</p>
          </>
        </article>
      ))
    }
  </div>
</section>
