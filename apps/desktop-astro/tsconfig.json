{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "../..",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@research-observatory/domain": ["packages/domain/src/index.ts"],
      "@research-observatory/content-engine": ["packages/content-engine/src/index.ts"],
      "@research-observatory/search-engine": ["packages/search-engine/src/index.ts"],
      "@research-observatory/application": ["packages/application/src/index.ts"],
      "@research-observatory/platform-contracts": ["packages/platform-contracts/src/index.ts"],
      "@research-observatory/renderer-ui": ["packages/renderer-ui/src/index.ts"],
      "@research-observatory/deep-research-guide": ["packages/deep-research-guide/src/index.ts"]
    }
  },
  "include": [".astro/types.d.ts", "src/**/*", "../desktop-electron/src/renderer/**/*"]
}
